{#- ============================================================================
    Page shell: head, header, drawer, footer, scripts.
    Pages extend this and fill the `body` block.
    ============================================================================ -#}
{%- import "icons.html.j2" as I with context -%}
{%- import "blocks.html.j2" as B with context -%}
<!DOCTYPE html>
<html lang="{{ c.lang }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seo.title }}</title>
<meta name="description" content="{{ seo.description }}">
{%- if seo.keywords %}
<meta name="keywords" content="{{ seo.keywords }}">
{%- endif %}
<meta name="author" content="{{ c.brand.legal }}">
<meta name="robots" content="{{ 'noindex, follow' if noindex else 'index, follow, max-image-preview:large' }}">
<meta name="theme-color" content="#131313">
<meta name="format-detection" content="telephone=no">

<link rel="canonical" href="{{ canonical }}">
<link rel="alternate" hreflang="uk" href="{{ alt_uk }}">
<link rel="alternate" hreflang="en" href="{{ alt_en }}">
<link rel="alternate" hreflang="x-default" href="{{ alt_uk }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ c.brand.name }}">
<meta property="og:locale" content="{{ c.locale }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:title" content="{{ seo.og_title or seo.title }}">
<meta property="og:description" content="{{ seo.og_description or seo.description }}">
<meta property="og:image" content="{{ base }}assets/img/og-{{ c.lang }}.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ seo.og_title or seo.title }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo.og_title or seo.title }}">
<meta name="twitter:description" content="{{ seo.og_description or seo.description }}">
<meta name="twitter:image" content="{{ base }}assets/img/og-{{ c.lang }}.jpg">

<link rel="icon" href="{{ p }}assets/icons/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ p }}assets/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="{{ p }}assets/icons/apple-touch-icon.png">
<link rel="manifest" href="{{ p }}site.webmanifest">

<link rel="preload" href="{{ p }}assets/fonts/onest.woff2" as="font" type="font/woff2" crossorigin>
{%- if hero_img %}
<link rel="preload" as="image" type="image/avif" imagesrcset="{{ srcset(hero_img, 'avif') }}" imagesizes="100vw" fetchpriority="high">
{%- endif %}
<link rel="stylesheet" href="{{ p }}assets/css/main.css">

{#- set .js before first paint so animated elements can be hidden without
    ever hiding them from a visitor whose JS failed -#}
<script>document.documentElement.classList.remove("no-js");document.documentElement.classList.add("js");</script>

<script type="application/ld+json">{{ jsonld }}</script>
</head>

<body class="{{ V.id }}">
<span class="sentinel" aria-hidden="true"></span>
<a class="skip" href="#main">{{ c.nav.skip }}</a>

<!-- ============================== HEADER ============================== -->
<header class="hdr{{ ' hdr--onlight' if light_header else '' }}">
  <div class="hdr__in">
    <a class="brand" href="{{ url_for('home') }}" aria-label="{{ c.a11y.logo_home }}">
      <svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true">{{ logo_mark }}</svg>
      <span class="brand__txt">
        <span class="brand__t1">{{ c.brand.word_1 }}</span>
        <span class="brand__t2">{{ c.brand.word_2 }}</span>
      </span>
    </a>

    <nav class="nav" aria-label="{{ c.nav.aria_nav }}">
      {%- for i in c.nav_pages['items'] %}
      <a class="nav__link" href="{{ url_for(i.page) }}"{% if i.page == page_id %} aria-current="page"{% endif %}>{{ i.label }}</a>
      {%- endfor %}
    </nav>

    <div class="hdr__right">
      <div class="lang" role="group" aria-label="{{ c.nav.lang_label }}">
        <a class="lang__i" href="{{ alt_uk_rel }}" aria-current="{{ 'true' if c.lang == 'uk' else 'false' }}" hreflang="uk">UA</a>
        <a class="lang__i" href="{{ alt_en_rel }}" aria-current="{{ 'true' if c.lang == 'en' else 'false' }}" hreflang="en">EN</a>
      </div>
      <a class="btn btn--sm" href="{{ url_for('contacts') }}">{{ c.nav.cta }}<span class="btn__badge">{{ I.arrow() }}</span></a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="drawer" aria-label="{{ c.nav.menu_open }}" data-label-open="{{ c.nav.menu_open }}" data-label-close="{{ c.nav.menu_close }}">
        <span class="burger__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ c.nav.aria_nav }}">
  <nav class="drawer__nav" aria-label="{{ c.nav.aria_nav }}">
    {%- for i in c.nav_pages['items'] %}
    <a class="drawer__link" href="{{ url_for(i.page) }}"><span>{{ i.label }}</span><span>{{ '%02d' % loop.index }}</span></a>
    {%- endfor %}
  </nav>
  <div class="drawer__foot">
    <a class="btn btn--block" href="{{ url_for('contacts') }}">{{ c.nav.cta }}<span class="btn__badge">{{ I.arrow() }}</span></a>
    <p class="drawer__meta">
      <a href="tel:{{ tel }}">{{ c.contact.phone }}</a><br>
      <a href="mailto:{{ c.contact.email }}">{{ c.contact.email }}</a>
    </p>
  </div>
</div>

<main id="main">
{% block body %}{% endblock %}
</main>

<!-- =============================== FOOTER ================================ -->
<div class="wrap footer-wrap">
  <footer class="footer">
    <div class="footer__top">
      <div class="footer__brandcol">
        <a class="brand" href="{{ url_for('home') }}" aria-label="{{ c.a11y.logo_home }}">
          <svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true">{{ logo_mark }}</svg>
          <span class="brand__txt">
            <span class="brand__t1">{{ c.brand.word_1 }}</span>
            <span class="brand__t2">{{ c.brand.word_2 }}</span>
          </span>
        </a>
        <p class="footer__tag">{{ c.footer.tagline }}</p>
        <form class="footer__nl" data-demo-form>
          <span class="footer__nl-l">{{ c.footer.newsletter_label }}</span>
          <label class="sr" for="f-nl">{{ c.footer.newsletter_ph }}</label>
          <div class="subscribe">
            <input id="f-nl" name="email" type="email" placeholder="{{ c.footer.newsletter_ph }}" required>
            <button class="btn btn--sm" type="submit">{{ c.footer.newsletter_cta }}<span class="btn__badge">{{ I.arrow() }}</span></button>
          </div>
          <div class="form__ok" aria-live="polite">{{ I.tick() }}<span>{{ c.contact.form.demo_notice }}</span></div>
        </form>
      </div>

      <div class="footer__cols">
        <nav aria-label="{{ c.footer.columns[0].title }}">
          <p class="footer__ct">{{ c.footer.columns[0].title }}</p>
          <div class="footer__links">
            {%- for i in c.nav_pages['items'] %}
            <a href="{{ url_for(i.page) }}">{{ i.label }}</a>
            {%- endfor %}
          </div>
        </nav>
        <nav aria-label="{{ c.footer.columns[1].title }}">
          <p class="footer__ct">{{ c.footer.columns[1].title }}</p>
          <div class="footer__links">
            {%- for l in c.footer.columns[1].links %}
            <a href="{{ url_for('services') }}">{{ l.label }}</a>
            {%- endfor %}
          </div>
        </nav>
        <nav aria-label="{{ c.footer.columns[2].title }}">
          <p class="footer__ct">{{ c.footer.columns[2].title }}</p>
          <div class="footer__links">
            {%- for l in c.footer.columns[2].links %}
            <a href="{{ url_for('contacts') }}">{{ l.label }}</a>
            {%- endfor %}
          </div>
        </nav>
      </div>
    </div>

    <div class="footer__bot">
      <p>&copy; {{ year }} {{ c.footer.copyright }}<br><span class="footer__demo">{{ c.footer.demo }}</span></p>
      <div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap">
        <a class="totop" href="{{ variants_url }}">{{ variant_switch_label }}</a>
        <a class="totop" href="#main">{{ c.footer.back_to_top }}{{ I.chevron('up') }}</a>
      </div>
    </div>
  </footer>
</div>

<script src="{{ p }}assets/js/vendor/gsap.min.js" defer></script>
<script src="{{ p }}assets/js/vendor/ScrollTrigger.min.js" defer></script>
<script src="{{ p }}assets/js/vendor/lenis.min.js" defer></script>
<script src="{{ p }}assets/js/app.js" defer></script>
</body>
</html>
