{#- ============================================================================
    Section library. Every block is a macro so the three variations can compose
    pages from the same parts in different orders — which is exactly how the
    source template's home/about/contact variants differ from one another.

    Imported with context, so macros see `c` (content), `V` (variant), `p`
    (path prefix), `imgs`, `srcset`, `url_for` from the rendering page.
    ============================================================================ -#}
{%- import "icons.html.j2" as I with context -%}
{%- import "partners.html.j2" as P with context -%}

{#- ---------------------------------------------------------------- images -#}
{%- macro pic(name, alt, sizes, priority=False, cls='') -%}
{%- set m = imgs[name] -%}
<picture{% if cls %} class="{{ cls }}"{% endif %}>
<source type="image/avif" srcset="{{ srcset(name, 'avif') }}" sizes="{{ sizes }}">
<img src="{{ p }}assets/img/{{ name }}-{{ m.widths[0] }}.webp" srcset="{{ srcset(name, 'webp') }}" sizes="{{ sizes }}" width="{{ m.widths[-1] }}" height="{{ m['h' ~ m.widths[-1]] }}" alt="{{ alt }}"{% if priority %} fetchpriority="high" decoding="sync"{% else %} loading="lazy" decoding="async"{% endif %}>
</picture>
{%- endmacro -%}

{%- macro btn(label, href, kind='', sm=False) -%}
<a class="btn{{ ' btn--' ~ kind if kind }}{{ ' btn--sm' if sm }}" href="{{ href }}">{{ label }}<span class="btn__badge">{{ I.arrow() }}</span></a>
{%- endmacro -%}

{%- macro stars(n=5) -%}
<span class="stars" aria-hidden="true">{% for i in range(n) %}{{ I.star() }}{% endfor %}</span>
{%- endmacro -%}

{#- =============================================================== HEROES = -#}

{%- macro hero_fan() -%}
<section class="hero hero--fan" data-hero aria-labelledby="hero-t">
  <div class="hero__bg" data-hero-media>{{ pic(V.hero_img, c.hero.image_alt, '100vw', priority=True) }}</div>
  <div class="hero__in wrap">
    <h1 id="hero-t" data-hero-title>{{ c.hero.title_1 }} <span class="soft">{{ c.hero.title_2 }}</span></h1>
    <p class="lead" data-hero-item>{{ c.hero.lead }}</p>
    <div class="hero__cta" data-hero-item>
      {{ btn(c.hero.cta_primary, url_for('contacts')) }}
      {{ btn(c.hero.cta_secondary, url_for('services'), 'ghost') }}
    </div>
    <p class="hero__trust" data-hero-item>{{ c.hero.trust }}</p>
  </div>
  <div class="hero__fan">{{ fan_cards() }}</div>
</section>
{%- endmacro -%}

{%- macro hero_pright() -%}
<section class="hero hero--pright" data-hero aria-labelledby="hero-t">
  <div class="hero__bg" data-hero-media>{{ pic(V.hero_img, c.hero.image_alt_v2, '100vw', priority=True) }}</div>
  <div class="wrap">
    <div class="hero__in">
      <span class="tag" data-hero-item>{{ c.hero.badge }}</span>
      <h1 id="hero-t" data-hero-title>{{ c.hero.title_1 }} <span class="soft">{{ c.hero.title_2 }}</span></h1>
      <p class="lead" data-hero-item>{{ c.hero.lead }}</p>
      <div class="hero__cta" data-hero-item>
        {{ btn(c.hero.cta_primary, url_for('contacts')) }}
        {{ btn(c.hero.cta_secondary, url_for('services'), 'ghost') }}
      </div>
      <div class="hero__rating" data-hero-item>{{ stars() }}<span>{{ c.hero.rating }}</span></div>
    </div>
  </div>
  <div class="card-rail">{{ card_rail() }}</div>
</section>
{%- endmacro -%}

{%- macro hero_pcentre() -%}
<section class="hero hero--pcentre" data-hero aria-labelledby="hero-t">
  <div class="hero__bg" data-hero-media>{{ pic(V.hero_img, c.hero.image_alt_v3, '100vw', priority=True) }}</div>
  <div class="hero__in wrap">
    <h1 id="hero-t" data-hero-title>{{ c.hero.title_1 }} <span class="soft">{{ c.hero.title_2 }}</span></h1>
    <p class="lead" data-hero-item>{{ c.hero.lead }}</p>
    <div class="hero__cta" data-hero-item>{{ btn(c.hero.cta_primary, url_for('contacts')) }}</div>
  </div>
  <div class="hero__foot" data-hero-item>
    <div class="wrap">
      <div class="logo-bar">
        <div class="logo-bar__rating">
          <b>{{ c.hero.rating }}</b>
          <span class="logo-bar__stars">{{ stars() }}</span>
        </div>
        <div class="marq" data-marquee="left" data-speed="46" data-marquee-hover>
          <div class="marq__track">{{ P.row(c.partners['items']) }}</div>
        </div>
      </div>
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro hero() -%}
{%- if V.hero == 'portrait-right' %}{{ hero_pright() }}
{%- elif V.hero == 'portrait-centre' %}{{ hero_pcentre() }}
{%- else %}{{ hero_fan() }}{% endif -%}
{%- endmacro -%}

{#- inner-page hero: compact, on a light surface -#}
{%- macro hero_page(eyebrow, title, lead, img='about-team', alt='', tags=None) -%}
<section class="wrap" aria-labelledby="ph-t">
  <div class="phero">
    <div class="phero__copy">
      <span class="tag tag--lime" data-r>{{ eyebrow }}</span>
      <h1 id="ph-t" data-split>{{ title }}</h1>
      {%- if lead %}<p class="lead" data-r data-delay=".12">{{ lead }}</p>{% endif %}
      <div data-r data-delay=".2">{{ avatars() }}</div>
    </div>
    <div class="phero__ph">{{ pic(img, alt or title, '(max-width: 64rem) 100vw, 50vw', priority=True) }}</div>
  </div>
</section>
{%- if tags %}{{ tag_band() }}{% endif %}
{%- endmacro -%}

{%- macro avatars() -%}
<span class="avatars">
  <span class="avatars__row">
    {%- for m in c.team['items'][:3] %}
    <img src="{{ p }}assets/img/{{ m.img }}-420.webp" width="420" height="525" alt="" loading="lazy" decoding="async">
    {%- endfor %}
    <span class="avatars__more">+{{ c.team['items'] | length }}</span>
  </span>
  <span class="avatars__t">{{ c.cta.trust }}</span>
</span>
{%- endmacro -%}

{#- ======================================================== HERO WIDGETS = -#}

{%- macro fcard(card, idx) -%}
<div class="fcard{{ ' fcard--dark' if card.kind in ('lab', 'pills') else '' }}{{ ' fcard--lime' if card.kind == 'stat' and idx == 5 else '' }}">
  {%- if card.kind == 'photo' %}
  <div class="fcard__ph">{{ pic(card.img, '', '12rem') }}</div>
  <span class="fcard__l">{{ card.label }}</span><span class="fcard__n">{{ card.note }}</span>
  {%- elif card.kind == 'stat' %}
  <span class="fcard__l">{{ card.label }}</span><span class="fcard__n">{{ card.note }}</span>
  <span class="fcard__big">{{ card.value }} <em>{{ card.unit }}</em></span>
  {%- elif card.kind == 'chart' %}
  <span class="fcard__l">{{ card.label }}, {{ card.unit }}</span>{{ chart_html(card.series) }}
  {%- elif card.kind == 'bars' %}
  <span class="fcard__l">{{ card.label }} · {{ card.value }}</span>
  <div class="bars">
    {%- for r in card.rows %}
    <div class="bars__row"><div class="bars__top"><span class="bars__name">{{ r.name }}</span><span class="bars__val">{{ r.pct }}%</span></div>
    <span class="bars__track"><span class="bars__fill" style="--w:{{ r.pct }}%"></span></span></div>
    {%- endfor %}
  </div>
  {%- elif card.kind == 'lab' %}
  <span class="fcard__l">{{ card.label }} · {{ card.note }}</span>
  <div class="lab">
    {%- for r in card.rows %}<div class="lab__row"><span class="lab__name">{{ r.name }}</span><span class="lab__val">{{ r.val }}</span></div>{% endfor %}
  </div>
  {%- elif card.kind == 'pills' %}
  <span class="fcard__l">{{ card.label }}</span><span class="fcard__n">{{ card.note }}</span>
  <div class="fcard__pills">{% for i in card['items'] %}<span class="fcard__pill">{{ i }}</span>{% endfor %}</div>
  {%- endif %}
</div>
{%- endmacro -%}

{%- macro fan_cards() -%}
<div class="fan">
  {%- for card in c.hero.cards %}
  {%- set f = fan[loop.index0] %}
  <div class="fan__item" style="--ry:{{ f.ry }}deg;--rz:{{ f.rz }}deg;--ty:{{ f.ty }}px;--tz:{{ f.tz }}px;--sc:{{ f.sc }};--z:{{ f.z }}" aria-hidden="true">{{ fcard(card, loop.index0) }}</div>
  {%- endfor %}
</div>
{%- endmacro -%}

{%- macro card_rail() -%}
<div class="marq" data-marquee="left" data-speed="34" data-marquee-hover aria-hidden="true">
  <div class="marq__track">
    {%- for pass_ in [1, 2] %}{% for card in c.hero.cards %}{{ fcard(card, loop.index0) }}{% endfor %}{% endfor %}
  </div>
</div>
{%- endmacro -%}

{%- macro logo_strip() -%}
<div class="strip">
  <div class="strip__in">
    <p class="strip__l"><span class="tag tag--lime">{{ c.partners.label }}</span></p>
    <div class="marq marq--logos" data-marquee="left" data-speed="52" data-marquee-hover>
      <div class="marq__track">{{ P.row(c.partners['items']) }}</div>
    </div>
  </div>
</div>
{%- endmacro -%}

{%- macro tag_band() -%}
<div class="tagband" aria-hidden="true">
  <div class="marq marq--tags" data-marquee="left" data-speed="40">
    <div class="marq__track">
      {%- for pass_ in [1, 2] %}{% for t in c.tagmarquee.row_a %}<span class="tag-pill{{ ' tag-pill--lime' if loop.index0 % 3 == 1 }}">{{ t }}</span>{% endfor %}{% endfor %}
    </div>
  </div>
  <div class="marq marq--tags" data-marquee="right" data-speed="40">
    <div class="marq__track">
      {%- for pass_ in [1, 2] %}{% for t in c.tagmarquee.row_b %}<span class="tag-pill{{ ' tag-pill--dark' if loop.index0 % 3 == 2 }}">{{ t }}</span>{% endfor %}{% endfor %}
    </div>
  </div>
</div>
{%- endmacro -%}

{#- ========================================================= HOME BLOCKS = -#}

{%- macro sec_about() -%}
<section class="section" id="about" aria-labelledby="about-t">
  <div class="wrap">
    <div class="about__grid">
      <div class="about__copy">
        <span class="tag tag--lime" data-r>{{ c.about.eyebrow }}</span>
        <h2 id="about-t" class="h-iconic" data-split>{{ iconic(c.about.title_rich) }}</h2>
        <p class="lead" data-r>{{ c.about.lead }}</p>
        {%- for para in c.about.body %}<p data-r data-delay=".{{ loop.index }}">{{ para }}</p>{% endfor %}
        <div class="about__cta" data-r>{{ btn(c.about.cta, url_for('services'), 'dark') }}</div>
      </div>
      <figure class="about__ph" data-r="right">
        <span data-parallax="8">{{ pic('about-team', c.about.image_alt, '(max-width: 64rem) 92vw, 44vw') }}</span>
        <figcaption class="about__badge">
          <span class="itile" aria-hidden="true">{{ I.icon('chart') }}</span>
          <span>{{ c.about.badge }}</span>
        </figcaption>
      </figure>
    </div>
    {{ sec_stats(inner=True) }}
  </div>
</section>
{%- endmacro -%}

{%- macro sec_stats(inner=False) -%}
{%- if not inner %}<section class="section" aria-label="{{ c.about.eyebrow }}"><div class="wrap">{% endif %}
<div class="stats about__stats" data-stagger=".08">
  {%- for s in c.about.stats %}
  <div class="stat">
    <span class="stat__v" data-count="{{ s.value }}" data-suffix="{{ s.suffix }}">0{{ s.suffix }}</span>
    <span class="stat__l">{{ s.label }}</span>
  </div>
  {%- endfor %}
</div>
{%- if not inner %}</div></section>{% endif %}
{%- endmacro -%}

{%- macro sec_crops() -%}
<section class="section" id="crops" aria-labelledby="crops-t">
  <div class="wrap">
    <div class="head-row">
      <div class="head">
        <span class="tag tag--lime" data-r>{{ c.crops.eyebrow }}</span>
        <h2 id="crops-t" class="h-iconic" data-split>{{ iconic(c.crops.title_rich) }}</h2>
        <p class="lead" data-r>{{ c.crops.lead }}</p>
      </div>
      <div data-r>{{ btn(c.crops.cta, url_for('contacts'), 'outline') }}</div>
    </div>
    <div class="crops">
      {%- for cr in c.crops['items'] %}
      <button class="crop" type="button" aria-expanded="{{ 'true' if loop.first else 'false' }}">
        <span class="crop__bg">{{ pic(cr.img, cr.alt, '(max-width: 64rem) 100vw, 46vw') }}</span>
        <span class="crop__spine">
          <span class="crop__vlabel">{{ cr.name }}</span>
          <span class="crop__varea">{{ cr.area }}</span>
        </span>
        <span class="crop__body">
          <span class="crop__name">{{ cr.name }}</span>
          <span class="crop__text">{{ cr.text }}</span>
          <dl class="crop__kpis">
            <div class="crop__kpi"><dt>{{ c.crops.spec_labels.area }}</dt><dd>{{ cr.area }}</dd></div>
            <div class="crop__kpi crop__kpi--accent"><dt>{{ c.crops.spec_labels.yield }}</dt><dd>{{ cr['yield'] }}</dd></div>
            <div class="crop__kpi"><dt>{{ c.crops.spec_labels.volume }}</dt><dd>{{ cr.volume }}</dd></div>
          </dl>
          <dl class="crop__specs">
            {%- for s in cr.specs %}<div class="crop__spec"><dt>{{ s.k }}</dt><dd>{{ s.v }}</dd></div>{% endfor %}
          </dl>
        </span>
      </button>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_capacity() -%}
<section class="section" id="capacity" aria-labelledby="cap-t">
  <div class="wrap">
    <div class="head head--center">
      <span class="tag tag--lime" data-r>{{ c.capacity.eyebrow }}</span>
      <h2 id="cap-t" class="h-iconic" data-split>{{ iconic(c.capacity.title_rich) }}</h2>
      <p class="lead" data-r>{{ c.capacity.lead }}</p>
    </div>
    <div class="cap">
      {%- for card in c.capacity.cards %}
      <article class="cap__card" data-card>
        <div class="cap__viz"
             {% if card.widget == 'chart' %}data-chart{% elif card.widget == 'bars' %}data-bars{% elif card.widget == 'orbit' %}data-orbit{% elif card.widget == 'lab' %}data-lab{% endif %}>
          {%- if card.widget == 'chart' %}
          <figure><figcaption class="sr">{{ c.a11y.chart_caption }}</figcaption>{{ chart_html(card.series, big=True) }}</figure>
          {%- elif card.widget == 'bars' %}
          <div class="bars">
            {%- for r in card.rows %}
            <div class="bars__row"><div class="bars__top"><span class="bars__name">{{ r.name }}</span><span class="bars__val">{{ r.val }}</span></div>
            <span class="bars__track"><span class="bars__fill" style="--w:{{ r.pct }}%"></span></span></div>
            {%- endfor %}
          </div>
          {%- elif card.widget == 'orbit' %}
          <div class="orbit">
            {%- for ins in ['4%', '20%', '36%'] %}<span class="orbit__ring" style="--inset:{{ ins }}" aria-hidden="true"></span>{% endfor %}
            <span class="orbit__hub">{{ card.center }}</span>
            {%- for it in card['items'] %}{% set o = orbit[loop.index0] %}
            <span class="orbit__arm" style="--a:{{ o.a }}deg;--r:{{ o.r }};--d:{{ o.d }}s">
              <span class="orbit__hold" style="--a:{{ o.a }}deg;--d:{{ o.d }}s">
                <span class="orbit__pill">{{ it }}</span>
              </span>
            </span>
            {%- endfor %}
          </div>
          {%- elif card.widget == 'lab' %}
          <div class="lab">
            {%- for r in card.rows %}
            <div class="lab__row{{ ' drift-a' if loop.index0 % 2 == 0 else ' drift-b' }}">
              <span class="lab__name">{{ r.name }}</span>
              <span class="lab__right"><span class="lab__val">{{ r.val }}</span>
              <span class="chip {{ 'chip--down' if '−' in r.trend or '-' in r.trend else 'chip--up' }}">{{ r.trend }}</span></span>
            </div>
            {%- endfor %}
          </div>
          {%- endif %}
        </div>
        <div class="cap__txt"><h3>{{ card.title }}</h3><p>{{ card.text }}</p></div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_process() -%}
<section class="section" id="process" aria-labelledby="proc-t">
  <div class="wrap">
    <div class="head">
      <span class="tag tag--lime" data-r>{{ c.process.eyebrow }}</span>
      <h2 id="proc-t" data-split>{{ c.process.title }}</h2>
      <p class="lead" data-r>{{ c.process.lead }}</p>
    </div>
    <ol class="proc" data-stagger=".1">
      {%- for s in c.process.steps %}
      <li class="step">
        <span class="step__n">{{ s.n }}</span>
        <div class="step__ph">{{ pic(s.img, s.alt, '(max-width: 35rem) 6.5rem, (max-width: 56.25rem) 46vw, 18vw') }}</div>
        <div class="step__body"><h3>{{ s.title }}</h3><p>{{ s.text }}</p></div>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_geo() -%}
<section class="section" id="geo" aria-labelledby="geo-t">
  <div class="wrap">
    <div class="head">
      <span class="tag tag--lime" data-r>{{ c.geo.eyebrow }}</span>
      <h2 id="geo-t" data-split>{{ c.geo.title }}</h2>
      <p class="lead" data-r>{{ c.geo.lead }}</p>
    </div>
    <div class="geo__grid">
      <div class="plan-map" data-r="left">
        {%- for cl in c.geo.clusters %}
        <div class="parcel">
          {{ pic(geo_imgs[loop.index0], cl.name ~ ' — ' ~ cl.role, '(max-width: 35rem) 92vw, 40vw') }}
          <span class="parcel__ha">{{ fmt_num(cl.area) }} {{ ha }}</span>
          <span class="parcel__n">{{ cl.name }}</span>
          <span class="parcel__r">{{ cl.role }}</span>
        </div>
        {%- endfor %}
      </div>
      <div class="geo__side">
        <div class="dists" data-r="right">
          {%- for d in c.geo.distances %}
          <div class="dist"><span class="dist__to">{{ d.to }}</span><span class="dist__km">{{ d.km }}</span></div>
          {%- endfor %}
        </div>
        <p class="geo__note" data-r="right" data-delay=".1">{{ c.geo.note }}</p>
      </div>
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_terms() -%}
<section class="section" id="terms" aria-labelledby="terms-t">
  <div class="wrap">
    <div class="head head--center">
      <span class="tag tag--lime" data-r>{{ c.terms.eyebrow }}</span>
      <h2 id="terms-t" data-split>{{ c.terms.title }}</h2>
      <p class="lead" data-r>{{ c.terms.lead }}</p>
    </div>
    <div class="plans" style="margin-top:3rem">
      {%- for pl in c.terms.plans %}
      <article class="plan{{ ' plan--hot' if pl.featured else '' }}" data-card>
        {%- if pl.featured %}<span class="plan__flag">{{ c.terms.recommended }}</span>{% endif %}
        <h3 class="plan__name">{{ pl.name }}</h3>
        <p class="plan__desc">{{ pl.desc }}</p>
        <p class="plan__price"><b>{{ pl.price }}</b><span>{{ pl.unit }}</span></p>
        <ul class="plan__list">
          {%- for it in pl['items'] %}<li>{{ I.tick() }}<span>{{ it }}</span></li>{% endfor %}
        </ul>
        <div class="plan__cta">
          <a class="btn btn--dark btn--block" href="{{ url_for('contacts') }}">{{ c.terms.cta }}<span class="btn__badge">{{ I.arrow() }}</span></a>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_testimonials() -%}
<section class="section" aria-labelledby="tst-t">
  <div class="wrap">
    <div class="head-row">
      <div class="head">
        <span class="tag tag--lime" data-r>{{ c.testimonials.eyebrow }}</span>
        <h2 id="tst-t" data-split>{{ c.testimonials.title }}</h2>
        <p class="lead" data-r>{{ c.testimonials.lead }}</p>
      </div>
      <div class="rail-btns" data-r>
        <button class="rail-btn" type="button" data-rail-prev aria-label="{{ c.testimonials.prev }}">{{ I.chevron('left') }}</button>
        <button class="rail-btn" type="button" data-rail-next aria-label="{{ c.testimonials.next }}">{{ I.chevron('right') }}</button>
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="rail" data-rail data-stagger=".1">
      {%- for t in c.testimonials['items'] %}
      <figure class="quote">
        <div class="quote__ph">{{ pic(t.img, t.alt, '23.5rem') }}</div>
        <div class="quote__body">
          <span class="quote__mark" aria-hidden="true">&bdquo;</span>
          <blockquote class="quote__txt">{{ t.quote }}</blockquote>
          <figcaption class="quote__who">
            <span class="quote__name">{{ t.name }}</span>
            <span class="quote__role">{{ t.role }}</span>
          </figcaption>
        </div>
      </figure>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_faq() -%}
<section class="section section--tight" id="faq" aria-labelledby="faq-t">
  <div class="wrap wrap--narrow">
    <div class="head" style="margin-bottom:2.25rem">
      <span class="tag tag--lime" data-r>{{ c.faq.eyebrow }}</span>
      <h2 id="faq-t" data-split>{{ c.faq.title }}</h2>
    </div>
    <div class="faq" data-stagger=".07">
      {%- for q in c.faq['items'] %}
      <details class="faq__i"{% if loop.first %} open{% endif %}>
        <summary class="faq__q">{{ q.q }}<span class="faq__ico" aria-hidden="true"></span></summary>
        <div class="faq__a">{{ q.a }}</div>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_news() -%}
<section class="section" id="news" aria-labelledby="news-t">
  <div class="wrap">
    <div class="head-row">
      <div class="head">
        <span class="tag tag--lime" data-r>{{ c.news.eyebrow }}</span>
        <h2 id="news-t" data-split>{{ c.news.title }}</h2>
      </div>
      <div data-r>{{ btn(c.news.cta, url_for('blog'), 'outline') }}</div>
    </div>
    <div class="news" data-stagger=".1">
      {%- for n in c.news['items'] %}
      <article class="post">
        {{ pic(n.img, n.alt, '(max-width: 35rem) 92vw, (max-width: 64rem) 46vw, 30vw') }}
        <div class="post__meta">
          <span class="chip chip--lime">{{ n.tag }}</span>
          <time class="post__date" datetime="{{ n.iso }}">{{ n.date }}</time>
        </div>
        <h3>{{ n.title }}</h3>
        <span class="post__go">{{ c.news.read }}{{ I.arrow() }}</span>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_cta() -%}
<section class="section section--tight" aria-labelledby="cta-t">
  <div class="wrap">
    <div class="ctap" data-r="in">
      <span data-parallax="10">{{ pic('cta-field', c.cta.image_alt, '(max-width: 80rem) 100vw, 76rem') }}</span>
      <div class="ctap__in">
        <span class="tag" style="color:rgba(255,255,255,.72)">{{ c.cta.trust }}</span>
        <h2 id="cta-t" data-split>{{ c.cta.title_1 }} <span class="soft">{{ c.cta.title_2 }}</span></h2>
        <p class="lead">{{ c.cta.lead }}</p>
        <div class="ctap__btn">{{ btn(c.cta.button, url_for('contacts')) }}</div>
      </div>
    </div>
  </div>
</section>
{%- endmacro -%}

{#- ======================================================== ABOUT BLOCKS = -#}

{%- macro sec_team(style='cards') -%}
<section class="section" id="team" aria-labelledby="team-t">
  <div class="wrap">
    <div class="head">
      <span class="tag tag--lime" data-r>{{ c.team.eyebrow }}</span>
      <h2 id="team-t" class="h-iconic" data-split>{{ iconic(c.team.title_rich) }}</h2>
      <p class="lead" data-r>{{ c.team.lead }}</p>
    </div>
    {%- if style == 'rail' %}
    <div class="rail" style="margin-top:2.5rem" data-stagger=".09">
      {%- for m in c.team['items'] %}
      <div class="member" style="width:min(17rem,74vw)">
        <div class="member__ph">{{ pic(m.img, m.alt, '17rem') }}<span class="member__role">{{ m.role }}</span></div>
        <div class="member__body"><span class="member__n">{{ m.name }}</span><p class="member__bio">{{ m.bio }}</p></div>
      </div>
      {%- endfor %}
    </div>
    {%- else %}
    <div class="team{{ ' team--wide' if style == 'grid-wide' }}" data-stagger=".09">
      {%- for m in c.team['items'] %}
      <div class="member member--top">
        <div class="member__head">
          <span class="member__n">{{ m.name }}</span>
          <span class="member__r">{{ m.role }}</span>
        </div>
        <span class="member__go" aria-hidden="true">{{ I.arrow() }}</span>
        <div class="member__ph">{{ pic(m.img, m.alt, '(max-width: 35rem) 92vw, (max-width: 75rem) 46vw, 22vw') }}</div>
        <p class="member__bio">{{ m.bio }}</p>
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro sec_journey() -%}
<section class="section" id="journey" aria-labelledby="jr-t">
  <div class="wrap">
    {%- if V.id == 'v2' %}
    {#- V2 keeps the vertical rail: it sits inside a dark band where a card grid
        would fight the surface. -#}
    <div class="head">
      <span class="tag tag--lime" data-r>{{ c.journey.eyebrow }}</span>
      <h2 id="jr-t" data-split>{{ c.journey.title }}</h2>
      <p class="lead" data-r>{{ c.journey.lead }}</p>
    </div>
    <div class="journey">
      {%- for m in c.journey['items'] %}
      <div class="milestone" data-r="right" data-delay=".{{ loop.index0 }}">
        <span class="milestone__y">{{ m.year }}</span>
        <div class="milestone__body"><h3>{{ m.title }}</h3><p>{{ m.text }}</p></div>
      </div>
      {%- endfor %}
    </div>
    {%- else %}
    <div class="jgrid">
      <div class="head">
        <span class="tag tag--lime" data-r>{{ c.journey.eyebrow }}</span>
        <h2 id="jr-t" data-split>{{ c.journey.title }}</h2>
        <p class="lead" data-r>{{ c.journey.lead }}</p>
      </div>
      <div class="jgrid__cards" data-stagger=".08">
        {%- for m in c.journey['items'] %}
        <article class="jcard">
          <span class="jcard__y">{{ m.year }}</span>
          <span class="jcard__t">{{ m.title }}</span>
          <p>{{ m.text }}</p>
        </article>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro sec_mission() -%}
<section class="section" id="mission" aria-labelledby="ms-t">
  <div class="wrap">
    <div class="head">
      <span class="tag tag--lime" data-r>{{ c.mission.eyebrow }}</span>
      <h2 id="ms-t" data-split>{{ c.mission.title }}</h2>
      <p class="lead" data-r>{{ c.mission.lead }}</p>
    </div>
    <div class="mission">
      {%- for v in c.mission['items'] %}
      <article class="value" data-card>
        <span class="itile" aria-hidden="true">{{ I.icon(v.icon) }}</span>
        <h3>{{ v.title }}</h3>
        <p>{{ v.text }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_intro() -%}
<section class="section" aria-labelledby="in-t">
  <div class="wrap">
    <div class="about__grid">
      <div class="about__copy">
        <span class="tag tag--lime" data-r>{{ c.about.eyebrow }}</span>
        <h2 id="in-t" data-split>{{ c.about.title }}</h2>
        <p class="lead" data-r>{{ c.about.lead }}</p>
        {%- for para in c.about.body %}<p data-r data-delay=".{{ loop.index }}">{{ para }}</p>{% endfor %}
      </div>
      <figure class="about__ph" data-r="right">
        <span data-parallax="8">{{ pic('about-team', c.about.image_alt, '(max-width: 64rem) 92vw, 44vw') }}</span>
      </figure>
    </div>
  </div>
</section>
{%- endmacro -%}

{#- ===================================================== SERVICES / BLOG = -#}

{%- macro sec_services() -%}
<section class="section" id="services" aria-labelledby="sv-t">
  <div class="wrap">
    <div class="head-row">
      <div class="head">
        <span class="tag tag--lime" data-r>{{ c.services.eyebrow }}</span>
        <h2 id="sv-t" class="h-iconic" data-split>{{ iconic(c.services.title_rich) }}</h2>
        <p class="lead" data-r>{{ c.services.lead }}</p>
      </div>
      <div data-r>{{ btn(c.services.cta, url_for('contacts'), 'outline') }}</div>
    </div>
    <div class="svc-list">
      {%- for s in c.services['items'] %}
      <article class="svc" data-card>
        <div class="svc__ph">{{ pic(s.img, s.alt, '(max-width: 64rem) 100vw, 46vw') }}</div>
        <div class="svc__body">
          <h3>{{ s.title }}</h3>
          <p>{{ s.text }}</p>
          <ul class="svc__points">
            {%- for pt in s.points %}<li>{{ I.tick() }}<span>{{ pt }}</span></li>{% endfor %}
          </ul>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_why() -%}
<section class="section" aria-labelledby="why-t">
  <div class="wrap">
    <div class="head">
      <span class="tag tag--lime" data-r>{{ c.why.eyebrow }}</span>
      <h2 id="why-t" data-split>{{ c.why.title }}</h2>
    </div>
    <div class="why" data-stagger=".1">
      {%- for w in c.why['items'] %}
      <div class="why__i"><span class="why__n">{{ w.n }}</span><h3>{{ w.title }}</h3><p>{{ w.text }}</p></div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{%- macro sec_blog() -%}
<section class="section" aria-labelledby="bg-t">
  <div class="wrap">
    <h2 id="bg-t" class="sr">{{ c.blog_page.title }}</h2>
    <div class="blog-grid" data-stagger=".09">
      {%- for n in c.blog_page.posts %}
      <article class="post">
        {{ pic(n.img, n.alt, '(max-width: 35rem) 92vw, (max-width: 64rem) 46vw, 30vw') }}
        <div class="post__meta">
          <span class="chip chip--lime">{{ n.tag }}</span>
          <time class="post__date" datetime="{{ n.iso }}">{{ n.date }}</time>
        </div>
        <h3>{{ n.title }}</h3>
        <p class="post__ex">{{ n.excerpt }}</p>
        <span class="post__go">{{ c.blog_page.read }}{{ I.arrow() }}</span>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endmacro -%}

{#- ============================================================ CONTACTS = -#}

{%- macro contact_form(dark=False) -%}
<form class="form{{ ' form--dark' if dark }}" data-demo-form novalidate>
  <div class="form__grid">
    <div class="field">
      <label for="f-name">{{ c.contact.form.name }}</label>
      <input id="f-name" name="name" type="text" autocomplete="organization" placeholder="{{ c.contact.form.name_ph }}" required>
    </div>
    <div class="field">
      <label for="f-mail">{{ c.contact.form.email }}</label>
      <input id="f-mail" name="contact" type="text" autocomplete="email" placeholder="{{ c.contact.form.email_ph }}" required>
    </div>
    <div class="field">
      <label for="f-crop">{{ c.contact.form.crop }}</label>
      <select id="f-crop" name="crop">
        {%- for o in c.contact.form.crop_options %}<option>{{ o }}</option>{% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="f-vol">{{ c.contact.form.volume }}</label>
      <input id="f-vol" name="volume" type="text" inputmode="numeric" placeholder="{{ c.contact.form.volume_ph }}">
    </div>
    <div class="field field--full">
      <label for="f-msg">{{ c.contact.form.message }}</label>
      <textarea id="f-msg" name="message" rows="4" placeholder="{{ c.contact.form.message_ph }}"></textarea>
    </div>
  </div>
  <div class="form__ok">{{ I.tick() }}<span>{{ c.contact.form.demo_notice }}</span></div>
  <button class="btn" type="submit">{{ c.contact.form.submit }}<span class="btn__badge">{{ I.arrow() }}</span></button>
  <p class="form__note">{{ c.contact.form.note }}</p>
</form>
{%- endmacro -%}

{%- macro contact_rows() -%}
<div class="cinfo">
  {%- for k, v in [(c.contact.address_label, c.contact.address), (c.contact.phone_label, None),
                   (c.contact.email_label, None), (c.contact.hours_label, c.contact.hours),
                   (c.contact.legal_label, c.contact.legal)] %}
  <div class="cinfo__row">
    <span class="cinfo__k">{{ k }}</span>
    <span class="cinfo__v">
      {%- if k == c.contact.phone_label %}<a href="tel:{{ tel }}">{{ c.contact.phone }}</a>
      {%- elif k == c.contact.email_label %}<a href="mailto:{{ c.contact.email }}">{{ c.contact.email }}</a>
      {%- else %}{{ v }}{% endif %}
    </span>
  </div>
  {%- endfor %}
</div>
{%- endmacro -%}

{%- macro contact_social() -%}
<div class="social">
  {%- for s in c.contact_page.social %}
  <a class="social__i" href="{{ s.href }}">{{ I.icon(s.icon) }}<b>{{ s.label }}</b><span>{{ s.handle }}</span></a>
  {%- endfor %}
</div>
{%- endmacro -%}

{%- macro contact_quick() -%}
<div class="ccards" data-stagger=".08">
  <a class="ccard" href="tel:{{ tel }}">
    <span class="itile" aria-hidden="true">{{ I.icon('phone') }}</span>
    <span class="ccard__k">{{ c.contact.phone_label }}</span>
    <span class="ccard__v">{{ c.contact.phone }}</span>
    <span class="ccard__n">{{ c.contact_page.phone_note }}</span>
  </a>
  <a class="ccard" href="mailto:{{ c.contact.email }}">
    <span class="itile" aria-hidden="true">{{ I.icon('mail') }}</span>
    <span class="ccard__k">{{ c.contact.email_label }}</span>
    <span class="ccard__v">{{ c.contact.email }}</span>
    <span class="ccard__n">{{ c.contact_page.email_note }}</span>
  </a>
  <a class="ccard" href="{{ c.contact_page.social[0].href }}">
    <span class="itile" aria-hidden="true">{{ I.icon('telegram') }}</span>
    <span class="ccard__k">{{ c.contact_page.social[0].label }}</span>
    <span class="ccard__v">{{ c.contact_page.social[0].handle }}</span>
    <span class="ccard__n">{{ c.contact_page.tg_note }}</span>
  </a>
  <div class="ccard">
    <span class="itile" aria-hidden="true">{{ I.icon('pin') }}</span>
    <span class="ccard__k">{{ c.contact.address_label }}</span>
    <span class="ccard__v" style="font-size:var(--fs-sm);line-height:1.5">{{ c.contact.address }}</span>
    <span class="ccard__n">{{ c.contact_page.addr_note }}</span>
  </div>
</div>
{%- endmacro -%}

{%- macro contact_way() -%}
<div class="cway" data-r="in">
  <div class="cway__body">
    <span class="tag tag--lime">{{ c.contact_page.visit_label }}</span>
    <h3>{{ c.contact_page.way_title }}</h3>
    <p class="text-sm muted">{{ c.contact_page.visit }}</p>
    <p class="text-sm muted">{{ c.contact_page.hours_note }}</p>
  </div>
  <div class="cway__ph">{{ pic('contact-yard', c.contact_page.photo_alt, '(max-width: 48rem) 92vw, 40vw') }}</div>
</div>
{%- endmacro -%}

{%- macro contact_answer() -%}
<div>
  <p class="tag tag--lime" style="margin-bottom:1rem">{{ c.contact_page.answer_label }}</p>
  <div class="answer" data-stagger=".1">
    {%- for m in c.team['items'][:2] %}
    <div class="answer__i">
      <span class="answer__ph"><img src="{{ p }}assets/img/{{ m.img }}-420.webp" width="420" height="525" alt="{{ m.alt }}" loading="lazy" decoding="async"></span>
      <span class="answer__b"><span class="answer__n">{{ m.name }}</span><span class="answer__r">{{ m.role }}</span></span>
    </div>
    {%- endfor %}
  </div>
</div>
{%- endmacro -%}

{%- macro contact_lines(compact=False) -%}
<div class="cinfo">
  <div class="cinfo__row"><span class="cinfo__k">{{ c.contact.email_label }}</span>
    <span class="cinfo__v"><a href="mailto:{{ c.contact.email }}">{{ c.contact.email }}</a></span></div>
  <div class="cinfo__row"><span class="cinfo__k">{{ c.contact.phone_label }}</span>
    <span class="cinfo__v"><a href="tel:{{ tel }}">{{ c.contact.phone }}</a></span></div>
  <div class="cinfo__row"><span class="cinfo__k">{{ c.contact.address_label }}</span>
    <span class="cinfo__v">{{ c.contact.address }}</span></div>
  {%- if not compact %}
  <div class="cinfo__row"><span class="cinfo__k">{{ c.contact.hours_label }}</span>
    <span class="cinfo__v">{{ c.contact.hours }}</span></div>
  {%- endif %}
</div>
{%- endmacro -%}

{%- macro social_chips() -%}
<div>
  <p class="tag tag--lime" style="margin-bottom:.75rem">{{ c.contact_page.social_label }}</p>
  <div class="chips">
    {%- for s in c.contact_page.social %}
    <a href="{{ s.href }}" aria-label="{{ s.label }}">{{ I.icon(s.icon) }}</a>
    {%- endfor %}
    <a href="mailto:{{ c.contact.email }}" aria-label="{{ c.contact.email_label }}">{{ I.icon('mail') }}</a>
  </div>
</div>
{%- endmacro -%}

{%- macro contacts_body() -%}
{%- if V.contact_layout == 'split' -%}
{#- V1 — grey panel one third, photograph two thirds, form card floating on it -#}
<section class="wrap ct" id="contact" aria-labelledby="ct-t">
  <div class="ct1">
    <div class="ct1__panel">
      <div style="display:flex;flex-direction:column;gap:var(--s-lg)">
        <span class="tag tag--lime" data-r>{{ c.contact_page.eyebrow }}</span>
        <h1 id="ct-t" data-split>{{ c.contact_page.title }}</h1>
        <p class="text-sm muted" data-r>{{ c.contact_page.lead }}</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:var(--s-xl)" data-r data-delay=".15">
        {{ contact_lines() }}
        {{ social_chips() }}
      </div>
    </div>
    <div class="ct1__media" data-r="right">
      {{ pic('contact-yard', c.contact_page.photo_alt, '(max-width: 64rem) 100vw, 64vw', priority=True) }}
      <div class="ct1__card">{{ contact_form() }}</div>
    </div>
  </div>
</section>
{%- elif V.contact_layout == 'centred-photo' -%}
{#- V2 — centred header, then one grey tray holding form + portrait strip -#}
<section class="wrap ct" id="contact" aria-labelledby="ct-t">
  <div class="head head--center">
    <span class="tag tag--lime" data-r>{{ c.contact_page.eyebrow }}</span>
    <h1 id="ct-t" data-split>{{ c.contact_page.title }}</h1>
    <p class="lead" data-r>{{ c.contact_page.lead }}</p>
  </div>
  <div class="ct2__tray" data-r="in">
    <div class="ct2__form">{{ contact_form() }}</div>
    <div class="ct2__side">
      {{ pic('contact-yard', c.contact_page.photo_alt, '(max-width: 64rem) 100vw, 30vw') }}
      <div class="ct2__mini">
        {{ contact_lines(compact=True) }}
        {{ social_chips() }}
      </div>
    </div>
  </div>
</section>
{%- else -%}
{#- V3 — no photograph, no containers: form naked on white, details beside it -#}
<section class="wrap ct" id="contact" aria-labelledby="ct-t">
  <div class="ct3">
    <div class="ct3__head">
      <span class="tag tag--lime" data-r>{{ c.contact_page.eyebrow }}</span>
      <h1 id="ct-t" data-split>{{ c.contact_page.title }}</h1>
      <p class="lead" data-r>{{ c.contact_page.lead }}</p>
    </div>
    <div data-r="left">{{ contact_form() }}</div>
    <div style="display:flex;flex-direction:column;gap:var(--s-xl)" data-r="right">
      {{ contact_lines() }}
      {{ social_chips() }}
      <p class="text-xs muted">{{ c.contact_page.visit }}</p>
    </div>
  </div>
</section>
{%- endif -%}
{%- endmacro -%}

{#- ================================================= section dispatcher = -#}
{%- macro render(name) -%}
{%- if   name == 'logos'        %}{{ logo_strip() }}
{%- elif name == 'about'        %}{{ sec_about() }}
{%- elif name == 'intro'        %}{{ sec_intro() }}
{%- elif name == 'stats'        %}{{ sec_stats() }}
{%- elif name == 'crops'        %}{{ sec_crops() }}
{%- elif name == 'capacity'     %}{{ sec_capacity() }}
{%- elif name == 'process'      %}{{ sec_process() }}
{%- elif name == 'geo'          %}{{ sec_geo() }}
{%- elif name == 'terms'        %}{{ sec_terms() }}
{%- elif name == 'testimonials' %}{{ sec_testimonials() }}
{%- elif name == 'faq'          %}{{ sec_faq() }}
{%- elif name == 'news'         %}{{ sec_news() }}
{%- elif name == 'cta'          %}{{ sec_cta() }}
{%- elif name == 'tagmarquee'   %}{{ tag_band() }}
{%- elif name == 'team'         %}{{ sec_team(V.team_style) }}
{%- elif name == 'journey'      %}{{ sec_journey() }}
{%- elif name == 'mission'      %}{{ sec_mission() }}
{%- elif name == 'services'     %}{{ sec_services() }}
{%- elif name == 'why'          %}{{ sec_why() }}
{%- elif name == 'blog'         %}{{ sec_blog() }}
{%- endif -%}
{%- endmacro -%}
