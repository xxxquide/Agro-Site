{#- ============================================================================
    Icon set, drawn for this project.
    One macro, one 24x24 grid, 1.7 stroke, round caps/joins — so every icon
    sits on the same optical weight as the template's own set. Fills use
    currentColor, so an icon inherits whatever colour its container sets.
    ============================================================================ -#}

{%- macro icon(name, cls='') -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
     {% if cls %}class="{{ cls }}"{% endif %}>
{%- if name == 'wheat' -%}
<path d="M12 21V9"/><path d="M12 9c0-2 1.6-3.4 1.6-3.4S15.2 7 15.2 9c0 2-1.6 3.4-1.6 3.4S12 11 12 9Z"/><path d="M12 9c0-2-1.6-3.4-1.6-3.4S8.8 7 8.8 9c0 2 1.6 3.4 1.6 3.4S12 11 12 9Z"/><path d="M12 14.5c0-1.8 1.5-3 1.5-3s1.5 1.2 1.5 3-1.5 3-1.5 3-1.5-1.2-1.5-3Z"/><path d="M12 14.5c0-1.8-1.5-3-1.5-3s-1.5 1.2-1.5 3 1.5 3 1.5 3 1.5-1.2 1.5-3Z"/>
{%- elif name == 'mill' -%}
<path d="M12 3v18"/><path d="M12 12 4.5 8.2"/><path d="m12 12 7.5-3.8"/><path d="M12 12l-3.4 7.2"/><circle cx="12" cy="12" r="1.6"/><path d="M4.5 21h15"/>
{%- elif name == 'drop' -%}
<path d="M12 3.5s5.2 5.4 5.2 9a5.2 5.2 0 1 1-10.4 0c0-3.6 5.2-9 5.2-9Z"/><path d="M9.6 14.6a2.6 2.6 0 0 0 2.4 2.4"/>
{%- elif name == 'grain' -%}
<ellipse cx="8.4" cy="9" rx="2.6" ry="4.2"/><ellipse cx="15.6" cy="15" rx="2.6" ry="4.2"/><path d="M8.4 4.8v8.4M15.6 10.8v8.4"/>
{%- elif name == 'beet' -%}
<path d="M12 8.5c3 0 5 2.2 5 5s-2.2 6-5 6-5-3.2-5-6 2-5 5-5Z"/><path d="M12 8.5V4"/><path d="M12 5.5c1.4-1.6 3.4-1.8 4.6-1.4-.2 1.4-1.4 3-3.2 3.2"/><path d="M12 6c-1.2-1.6-3-1.9-4.3-1.6.1 1.4 1.2 2.9 2.9 3.2"/>
{%- elif name == 'box' -%}
<path d="M4 8.4 12 4.5l8 3.9v7.2L12 19.5 4 15.6Z"/><path d="M4 8.4l8 3.9 8-3.9M12 12.3v7.2"/>
{%- elif name == 'ship' -%}
<path d="M4 14.5h16l-1.7 4.2a2 2 0 0 1-1.9 1.3H7.6a2 2 0 0 1-1.9-1.3Z"/><path d="M6.5 14.5V9.2L12 7l5.5 2.2v5.3"/><path d="M12 7V3.8"/>
{%- elif name == 'hop' -%}
<path d="M12 4.2c2.6 0 4.4 2 4.4 4.6 0 4-4.4 10.8-4.4 10.8S7.6 12.8 7.6 8.8C7.6 6.2 9.4 4.2 12 4.2Z"/><path d="M12 7.4v8.4M9.6 9.6h4.8M10.2 12.6h3.6"/>
{%- elif name == 'leaf' -%}
<path d="M20 4.5c0 8-4.7 12.4-10 12.4a5 5 0 0 1-5-5C5 6.6 11.6 4.5 20 4.5Z"/><path d="M5.5 20.5c1.6-5.4 5.4-9.4 10-11.6"/>
{%- elif name == 'flask' -%}
<path d="M9.5 3.5h5v4.2l4 8.3a2.6 2.6 0 0 1-2.4 3.8H7.9a2.6 2.6 0 0 1-2.4-3.8l4-8.3Z"/><path d="M7 14.5h10M9.5 3.5h5"/>
{%- elif name == 'handshake' -%}
<path d="m3.5 12.5 3.4-3.4a2 2 0 0 1 2.8 0l1.1 1.1a1.6 1.6 0 0 0 2.3 0l.7-.7"/><path d="m12 18.5 2.6 1.4a1.8 1.8 0 0 0 2.4-.9l3.5-7.2-4.3-4.3H9.9L7.5 9.9"/><path d="m9 14 2 2"/>
{%- elif name == 'route' -%}
<circle cx="6" cy="6" r="2.4"/><circle cx="18" cy="18" r="2.4"/><path d="M6 8.4v3.4a3.6 3.6 0 0 0 3.6 3.6h4.8"/><path d="m12.6 13.2 1.8 2.2-1.8 2.2"/>
{%- elif name == 'chart' -%}
<path d="M4 19V9m5 10V5m5 14v-7m5 7V8"/>
{%- elif name == 'silo' -%}
<path d="M6.5 20V9.5a5.5 5.5 0 0 1 11 0V20"/><path d="M5 20h14M6.5 13h11M6.5 16.5h11"/>
{%- elif name == 'drone' -%}
<rect x="9.5" y="9.5" width="5" height="5" rx="1.4"/><path d="M9.5 10.5 6 7M14.5 10.5 18 7M9.5 13.5 6 17M14.5 13.5 18 17"/><circle cx="5" cy="6" r="1.6"/><circle cx="19" cy="6" r="1.6"/><circle cx="5" cy="18" r="1.6"/><circle cx="19" cy="18" r="1.6"/>
{%- elif name == 'truck' -%}
<path d="M2.5 16.5V7.5h10v9"/><path d="M12.5 10.5H17l3.5 3.5v2.5h-8"/><circle cx="7" cy="18" r="1.8"/><circle cx="16.5" cy="18" r="1.8"/>
{%- elif name == 'telegram' -%}
<path d="M20.5 4.5 2.8 11.3l4.7 1.6 1.7 5.4 2.6-2.9 4 3 4.7-13.9Z"/><path d="m7.5 12.9 9.5-6-6.3 8.7"/>
{%- elif name == 'phone' -%}
<path d="M7.2 3.8h2.4l1.4 3.6-1.9 1.4a10 10 0 0 0 4.5 4.5l1.4-1.9 3.6 1.4v2.4a2 2 0 0 1-2.2 2A15.4 15.4 0 0 1 5.2 6a2 2 0 0 1 2-2.2Z"/>
{%- elif name == 'linkedin' -%}
<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.8v.2M12 16v-3.2a1.8 1.8 0 0 1 3.6 0V16"/>
{%- elif name == 'pin' -%}
<path d="M12 21s6.2-6 6.2-10.4A6.2 6.2 0 0 0 5.8 10.6C5.8 15 12 21 12 21Z"/><circle cx="12" cy="10.4" r="2.2"/>
{%- elif name == 'clock' -%}
<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
{%- elif name == 'mail' -%}
<rect x="3" y="5.5" width="18" height="13" rx="2.4"/><path d="m3.8 7 8.2 6 8.2-6"/>
{%- elif name == 'doc' -%}
<path d="M6.5 3.5h7L18 8v12.5h-11.5Z"/><path d="M13.5 3.5V8H18M9 12.5h6M9 16h4"/>
{%- elif name == 'shield' -%}
<path d="M12 3.5 5.5 6v5.4c0 4 2.7 7.4 6.5 9.1 3.8-1.7 6.5-5.1 6.5-9.1V6Z"/><path d="m9 12 2.2 2.2L15.2 10"/>
{%- endif -%}
</svg>
{%- endmacro -%}

{#- --- solid / filled glyphs, kept separate because they carry no stroke --- -#}

{%- macro arrow() -%}<svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M9.5 2.5H4.2M9.5 2.5v5.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endmacro -%}

{%- macro chevron(dir) -%}<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="{% if dir == 'left' %}M10 2.5 4.5 8l5.5 5.5{% elif dir == 'up' %}M2.5 10 8 4.5l5.5 5.5{% else %}M6 2.5 11.5 8 6 13.5{% endif %}" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endmacro -%}

{%- macro tick() -%}<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="m6 10.4 2.6 2.6L14 7.6" stroke="var(--lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endmacro -%}

{%- macro star() -%}<svg viewBox="0 0 12 12" aria-hidden="true"><path d="m6 .8 1.6 3.4 3.6.5-2.6 2.6.6 3.7L6 9.3 2.8 11l.6-3.7L.8 4.7l3.6-.5Z" fill="currentColor"/></svg>{%- endmacro -%}

{#- Partner wordmark: our own icon plus the name set in the site's mono face,
    so the row reads as a logo strip without importing anyone's real trademark. -#}
{%- macro wordmark(name, kind) -%}
<span class="logo-mark">{{ icon(kind) }}<span class="logo-mark__t">{{ name }}</span></span>
{%- endmacro -%}
